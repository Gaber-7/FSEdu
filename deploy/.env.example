# ═══════════════════════════════════════════════════════════
# FSEdu — Production Environment Variables
# Copy this file to ../.env (in project root) and fill in values
# ═══════════════════════════════════════════════════════════

# ─── Domain & Public URLs ─────────────────────────────────
DOMAIN=fsedu.example.com
PUBLIC_URL=https://fsedu.example.com

# ─── Database ─────────────────────────────────────────────
# SQL Server SA password (must be strong: 8+ chars, upper, digit, symbol)
DB_SA_PASSWORD=ChangeMe!StrongPass123

# ─── JWT Signing ─────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=replace_with_random_48_byte_base64_string

# ─── LiveKit Server ──────────────────────────────────────
# Generate API Key/Secret pair:
#   openssl rand -hex 12   (for API_KEY, must start with "API")
#   openssl rand -hex 32   (for API_SECRET)
LIVEKIT_API_KEY=APIabcdefghijklmnopqrst
LIVEKIT_API_SECRET=replace_with_64_char_hex_secret_here_xxxxxxxxxxxxxxxxxx
# Public WebSocket URL (returned to browsers in JoinLiveResponse).
# Caddy proxies wss://${DOMAIN}/livekit → host LiveKit on 127.0.0.1:7880
LIVEKIT_URL=wss://fsedu.example.com/livekit

# ─── TURN Server (optional, for stricter networks) ───────
TURN_SECRET=replace_with_random_string

# ─── Payment Account Details (manual payments) ────────────
INSTAPAY_NUMBER=+201012345678
INSTAPAY_LINK=https://ipn.eg/S/fsedu/instapay/ABC123
VFCASH_NUMBER=+201012345678
BANK_NAME=البنك التجاري الدولي - CIB
BANK_ACCOUNT=100012345678900
BANK_IBAN=EG380010000100012345678900
ACCOUNT_HOLDER=FullScreen Solutions - FSEdu

# ─── Notes ────────────────────────────────────────────────
# - Never commit .env to git (it's in .gitignore)
# - Backup .env securely (password manager / encrypted vault)
# - Rotate secrets periodically
