@page "/admin/campaigns"
@rendermode InteractiveServer
@inject FSEdu.Web.Services.ApiClient Api
@inject FSEdu.Web.Services.AuthState Auth
@inject NavigationManager Nav

<PageTitle>حملات الخصم</PageTitle>

<div class="ac-page">
    <div class="fs-container">
        <header class="ac-head">
            <h1>🎉 حملات الخصم التلقائية</h1>
            <button class="fs-btn fs-btn-primary fs-btn-sm" @onclick="() => _showForm = !_showForm">
                @(_showForm ? "إغلاق" : "➕ حملة جديدة")
            </button>
        </header>
        <p class="fs-text-muted">على عكس الكوبونات، الحملة تُطبَّق تلقائيًا عند الاشتراك دون الحاجة لكود.</p>

        @if (_showForm)
        {
            <div class="fs-card ac-form">
                <h3>إنشاء حملة جديدة</h3>
                <div class="ac-grid">
                    <div class="full">
                        <label>عنوان الحملة</label>
                        <input type="text" class="ac-input" maxlength="255"
                               placeholder="مثلاً: العودة للمدارس - خصم خاص"
                               @bind="_title" @bind:event="oninput" />
                    </div>
                    <div>
                        <label>نسبة الخصم %</label>
                        <input type="number" class="ac-input" min="1" max="100" step="0.5"
                               @bind="_discount" />
                    </div>
                    <div>
                        <label>النطاق</label>
                        <select class="ac-input" @bind="_scope" @bind:after="OnScopeChanged">
                            <option value="All">كل الاشتراكات</option>
                            <option value="Stage">مرحلة محدّدة</option>
                            <option value="Subject">مادة محدّدة</option>
                        </select>
                    </div>
                    @if (_scope == "Stage")
                    {
                        <div>
                            <label>المرحلة</label>
                            <select class="ac-input" @bind="_stageId">
                                <option value="0">— اختر —</option>
                                @if (_stages is not null)
                                {
                                    @foreach (var s in _stages)
                                    {
                                        <option value="@s.Id">@s.NameAr</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    @if (_scope == "Subject")
                    {
                        <div>
                            <label>المادة</label>
                            <select class="ac-input" @bind="_subjectId">
                                <option value="0">— اختر —</option>
                                @if (_subjects is not null)
                                {
                                    @foreach (var s in _subjects)
                                    {
                                        <option value="@s.Id">@s.NameAr</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    <div>
                        <label>تاريخ البدء</label>
                        <input type="datetime-local" class="ac-input" @bind="_fromDate" />
                    </div>
                    <div>
                        <label>تاريخ الانتهاء</label>
                        <input type="datetime-local" class="ac-input" @bind="_untilDate" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="fs-alert fs-alert-error">@_error</div>
                }
                <div class="ac-actions">
                    <button class="fs-btn fs-btn-primary" @onclick="Create" disabled="@_saving">
                        @(_saving ? "جارٍ الحفظ..." : "✓ إنشاء الحملة")
                    </button>
                    <button class="fs-btn fs-btn-outline" @onclick="() => _showForm = false">إلغاء</button>
                </div>
            </div>
        }

        @if (!_loaded)
        {
            <div class="fs-center" style="padding:60px"><span class="fs-spinner"></span></div>
        }
        else if (_items.Count == 0)
        {
            <div class="fs-card empty">
                <div style="font-size:64px">🎟️</div>
                <h3>لا توجد حملات خصم بعد</h3>
                <p class="fs-text-muted">أنشئ حملة موسمية مثل "صيف 2026 - خصم 30%" لزيادة الاشتراكات.</p>
            </div>
        }
        else
        {
            <div class="ac-list">
                @foreach (var c in _items)
                {
                    <article class="ac-card fs-card @(c.IsLive ? "live" : (!c.Active ? "off" : "pending"))">
                        <div class="ac-card-top">
                            <strong>@c.Title</strong>
                            <span class="ac-discount">-@c.DiscountPct.ToString("0.##")%</span>
                        </div>
                        <div class="ac-card-meta">
                            <span class="ac-pill scope">
                                @(c.Scope switch {
                                    "All" => "🌍 كل الاشتراكات",
                                    "Stage" => $"📚 المرحلة: {c.ScopeName}",
                                    "Subject" => $"📖 المادة: {c.ScopeName}",
                                    _ => c.Scope
                                })
                            </span>
                            <span class="ac-pill @(c.IsLive ? "ok" : (c.Active ? "warn" : "off"))">
                                @(c.IsLive ? "🟢 نشطة الآن" : (c.Active ? "⏳ بانتظار البدء/منتهية" : "⏸ معطّلة"))
                            </span>
                        </div>
                        <div class="ac-card-dates">
                            <span>من: @c.ValidFromUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                            <span>إلى: @c.ValidUntilUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                        </div>
                        <div class="ac-card-actions">
                            @if (c.Active)
                            {
                                <button class="fs-btn fs-btn-outline fs-btn-sm" @onclick="() => SetActive(c.Id, false)">إيقاف</button>
                            }
                            else
                            {
                                <button class="fs-btn fs-btn-primary fs-btn-sm" @onclick="() => SetActive(c.Id, true)">تفعيل</button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

<style>
    .ac-page { padding: var(--fs-s-8) 0; min-height: calc(100vh - 72px); }
    .ac-head { display: flex; justify-content: space-between; align-items: center; gap: var(--fs-s-2); margin-bottom: 4px; flex-wrap: wrap; }
    .ac-head h1 { margin: 0; font-size: 24px; }

    .ac-form { padding: var(--fs-s-5); margin: var(--fs-s-4) 0; }
    .ac-form h3 { margin: 0 0 var(--fs-s-3); }
    .ac-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--fs-s-3); }
    .ac-grid .full { grid-column: 1 / -1; }
    .ac-grid label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; }
    .ac-input { width: 100%; padding: var(--fs-s-2) var(--fs-s-3); border: 1px solid var(--fs-border); border-radius: var(--fs-r-md); font-size: 14px; font-family: inherit; }
    .ac-input:focus { outline: none; border-color: var(--fs-primary); }
    .ac-actions { margin-top: var(--fs-s-3); display: flex; gap: var(--fs-s-2); }

    .empty { padding: 60px var(--fs-s-5); text-align: center; }
    .empty h3 { margin: var(--fs-s-3) 0 var(--fs-s-2); }

    .ac-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--fs-s-3); margin-top: var(--fs-s-3); }
    .ac-card { padding: var(--fs-s-4); display: flex; flex-direction: column; gap: var(--fs-s-2); border-right: 4px solid var(--fs-border); }
    .ac-card.live { border-right-color: var(--fs-success); background: linear-gradient(135deg, #DCFCE7 0%, var(--fs-surface) 60%); }
    .ac-card.pending { border-right-color: var(--fs-accent); }
    .ac-card.off { border-right-color: var(--fs-text-muted); opacity: 0.7; }
    .ac-card-top { display: flex; justify-content: space-between; align-items: center; gap: var(--fs-s-2); }
    .ac-card-top strong { font-size: 16px; }
    .ac-discount { font-family: monospace; direction: ltr; font-size: 22px; font-weight: 800; color: var(--fs-primary); }
    .ac-card-meta { display: flex; gap: 4px; flex-wrap: wrap; }
    .ac-pill { font-size: 11px; padding: 2px 8px; border-radius: var(--fs-r-full); background: var(--fs-bg); }
    .ac-pill.ok { background: #DCFCE7; color: #166534; }
    .ac-pill.warn { background: #FEF3C7; color: #92400E; }
    .ac-pill.off { background: #FEE2E2; color: #991B1B; }
    .ac-card-dates { display: flex; gap: var(--fs-s-3); font-size: 12px; color: var(--fs-text-muted); flex-wrap: wrap; }
    .ac-card-actions { display: flex; gap: var(--fs-s-2); }
</style>

@code {
    private List<FSEdu.Shared.Contracts.Admin.SalesCampaignDto> _items = new();
    private List<FSEdu.Shared.Contracts.Reference.StageDto>? _stages;
    private List<FSEdu.Shared.Contracts.Reference.SubjectDto>? _subjects;
    private bool _loaded;
    private bool _showForm;
    private bool _saving;
    private string? _error;

    private string _title = "";
    private decimal _discount = 20m;
    private string _scope = "All";
    private int _stageId;
    private int _subjectId;
    private DateTime _fromDate = DateTime.Now;
    private DateTime _untilDate = DateTime.Now.AddDays(14);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.RestoreAsync();
            if (Auth.CurrentUser is null || !Auth.IsInRole("Admin"))
            {
                Nav.NavigateTo("/login");
                return;
            }
            _stages = await Api.GetStagesAsync();
            await Load();
        }
    }

    private async Task Load()
    {
        _items = await Api.GetCampaignsAsync();
        _loaded = true;
        StateHasChanged();
    }

    private async Task OnScopeChanged()
    {
        if (_scope == "Subject" && _subjects is null)
        {
            // pull all subjects (no stage filter — fall back to first stage's subjects for now)
            // Simplest UX: load all subjects across stages by aggregating; we already have GetSubjectsAsync(stageId)
            // For Admin convenience, take subjects from each stage and dedupe.
            _subjects = new();
            if (_stages is not null)
            {
                var all = new Dictionary<int, FSEdu.Shared.Contracts.Reference.SubjectDto>();
                foreach (var st in _stages)
                {
                    try
                    {
                        var subs = await Api.GetSubjectsAsync(st.Id);
                        foreach (var s in subs) all[s.Id] = s;
                    }
                    catch { }
                }
                _subjects = all.Values.OrderBy(s => s.NameAr).ToList();
            }
        }
        StateHasChanged();
    }

    private async Task Create()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_title) || _title.Trim().Length < 3)
        { _error = "العنوان قصير جدًا"; return; }
        if (_discount <= 0 || _discount > 100) { _error = "نسبة الخصم بين 1 و 100"; return; }
        if (_untilDate <= _fromDate) { _error = "تاريخ الانتهاء يجب أن يكون بعد البداية"; return; }
        if (_scope == "Stage" && _stageId == 0) { _error = "اختر المرحلة"; return; }
        if (_scope == "Subject" && _subjectId == 0) { _error = "اختر المادة"; return; }

        var req = new FSEdu.Shared.Contracts.Admin.CreateCampaignRequest(
            _title.Trim(), _discount, _scope,
            _scope == "Stage" ? _stageId : (_scope == "Subject" ? _subjectId : (int?)null),
            _fromDate.ToUniversalTime(), _untilDate.ToUniversalTime());

        _saving = true; StateHasChanged();
        try
        {
            var (id, err) = await Api.CreateCampaignAsync(req);
            if (err is not null) { _error = err.Message ?? "تعذّر الإنشاء"; return; }
            _title = ""; _discount = 20m; _stageId = 0; _subjectId = 0;
            _showForm = false;
            await Load();
        }
        finally { _saving = false; StateHasChanged(); }
    }

    private async Task SetActive(int id, bool active)
    {
        var ok = await Api.SetCampaignActiveAsync(id, active);
        if (ok) await Load();
    }
}
