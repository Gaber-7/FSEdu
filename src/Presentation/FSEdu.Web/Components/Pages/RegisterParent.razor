@page "/register/parent"
@rendermode InteractiveServer
@inject FSEdu.Web.Services.ApiClient Api
@inject FSEdu.Web.Services.AuthState Auth
@inject NavigationManager Nav

<PageTitle>تسجيل ولي أمر — FSEdu</PageTitle>

<div class="auth-wrapper">
    <div class="fs-container">
        <div class="auth-card fs-card fs-card-elevated">
            <div class="auth-head">
                <span class="fs-badge fs-badge-secondary">👨‍👩‍👦 حساب ولي أمر</span>
                <h1>تابع أبناءك أينما كانوا</h1>
                <p class="fs-text-muted">أنشئ حسابك للاطلاع على أداء أبنائك وتقاريرهم الأسبوعية</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="fs-alert fs-alert-error"><span>⚠️</span><span>@_errorMessage</span></div>
            }

            @if (_success)
            {
                <div class="fs-alert fs-alert-success"><span>✓</span><span>تم إنشاء الحساب بنجاح!</span></div>
            }

            <EditForm Model="@_form" OnValidSubmit="HandleSubmit" FormName="RegisterParent">
                <DataAnnotationsValidator />

                <div class="fs-form-group">
                    <label class="fs-label">الاسم الكامل</label>
                    <InputText class="fs-input" @bind-Value="_form.FullName" placeholder="محمد أحمد" />
                    <ValidationMessage For="() => _form.FullName" />
                </div>

                <div class="fs-form-group">
                    <label class="fs-label">رقم الهاتف</label>
                    <InputText class="fs-input fs-input-phone" @bind-Value="_form.Phone" placeholder="+201012345678" />
                    <ValidationMessage For="() => _form.Phone" />
                </div>

                <div class="fs-form-group">
                    <label class="fs-label">البريد الإلكتروني (اختياري)</label>
                    <InputText type="email" class="fs-input" @bind-Value="_form.Email" placeholder="you@example.com" />
                    <ValidationMessage For="() => _form.Email" />
                </div>

                <div class="fs-form-group">
                    <label class="fs-label">كلمة المرور</label>
                    <InputText type="password" class="fs-input" @bind-Value="_form.Password" placeholder="8 أحرف + رقم" />
                    <ValidationMessage For="() => _form.Password" />
                </div>

                <div class="fs-form-row">
                    <div class="fs-form-group">
                        <label class="fs-label">الرقم القومي (اختياري)</label>
                        <InputText class="fs-input fs-input-phone" @bind-Value="_form.NationalId" placeholder="14 رقمًا" />
                        <ValidationMessage For="() => _form.NationalId" />
                    </div>
                    <div class="fs-form-group">
                        <label class="fs-label">المهنة (اختياري)</label>
                        <InputText class="fs-input" @bind-Value="_form.Occupation" placeholder="مهندس، طبيب، ..." />
                    </div>
                </div>

                <button type="submit" class="fs-btn fs-btn-primary fs-btn-lg fs-btn-block" disabled="@_loading">
                    @if (_loading) { <span class="fs-spinner"></span><span>جارٍ التسجيل...</span> }
                    else { <span>إنشاء الحساب</span><span>←</span> }
                </button>

                <div class="auth-alt">
                    لديك حساب بالفعل؟ <a href="/login">تسجيل الدخول</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .auth-wrapper {
        padding: 60px 0; min-height: calc(100vh - 72px);
        display: flex; align-items: flex-start;
        background:
            radial-gradient(at 10% 0%, var(--fs-secondary-soft) 0%, transparent 50%),
            radial-gradient(at 90% 100%, var(--fs-primary-soft) 0%, transparent 50%);
    }
    .auth-card { max-width: 560px; margin: 0 auto; }
    .auth-head { text-align: center; margin-bottom: var(--fs-s-8); }
    .auth-head h1 { font-size: 28px; margin: var(--fs-s-3) 0 var(--fs-s-2); }
    .fs-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--fs-s-4); }
    @@media (max-width: 600px) { .fs-form-row { grid-template-columns: 1fr; } }
    .auth-alt { text-align: center; margin-top: var(--fs-s-6); color: var(--fs-text-muted); font-size: 14px; }
</style>

@code {
    private FormModel _form = new();
    private string? _errorMessage;
    private bool _loading;
    private bool _success;

    private async Task HandleSubmit()
    {
        _errorMessage = null; _loading = true;
        try
        {
            var req = new FSEdu.Shared.Contracts.Auth.RegisterParentRequest(
                _form.FullName, _form.Phone, _form.Email, _form.Password,
                _form.NationalId, _form.Occupation);

            var (data, error) = await Api.RegisterParentAsync(req);
            if (error is not null) { _errorMessage = error.Message; return; }

            _success = true;
            if (data is not null) await Auth.SaveAsync(data);
            await Task.Delay(900);
            Nav.NavigateTo("/parent/children");
        }
        catch (Exception ex) { _errorMessage = "خطأ: " + ex.Message; }
        finally { _loading = false; }
    }

    private class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "الاسم مطلوب")]
        [System.ComponentModel.DataAnnotations.StringLength(200, MinimumLength = 3)]
        public string FullName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "رقم الهاتف مطلوب")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^\+[1-9]\d{7,14}$", ErrorMessage = "صيغة رقم الهاتف غير صحيحة")]
        public string Phone { get; set; } = "";

        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "صيغة البريد غير صحيحة")]
        public string? Email { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "كلمة المرور مطلوبة")]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 8, ErrorMessage = "كلمة المرور 8 أحرف على الأقل")]
        public string Password { get; set; } = "";

        [System.ComponentModel.DataAnnotations.RegularExpression(@"^\d{14}$", ErrorMessage = "الرقم القومي يجب أن يكون 14 رقمًا")]
        public string? NationalId { get; set; }

        public string? Occupation { get; set; }
    }
}
