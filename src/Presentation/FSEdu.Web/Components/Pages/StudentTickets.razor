@page "/student/tickets"
@page "/student/ask-teacher"
@rendermode InteractiveServer
@inject FSEdu.Web.Services.ApiClient Api
@inject FSEdu.Web.Services.AuthState Auth

<PageTitle>اسأل مدرس — أسئلتي</PageTitle>

<div class="tickets-page">
    <div class="fs-container">
        <div class="page-head">
            <div>
                <h1>💬 اسأل مدرس</h1>
                <p class="fs-text-muted">اطرح سؤالك واحصل على إجابة من مدرسي المنصة</p>
            </div>
            <a href="/student/tickets/new" class="fs-btn fs-btn-primary">+ سؤال جديد</a>
        </div>

        @if (!_loaded)
        {
            <div class="fs-center" style="padding:60px"><span class="fs-spinner"></span></div>
        }
        else if (!Auth.IsAuthenticated)
        {
            <div class="fs-alert fs-alert-error">يجب تسجيل الدخول. <a href="/login">تسجيل الدخول</a></div>
        }
        else if (_tickets is null || !_tickets.Any())
        {
            <div class="fs-card fs-center empty">
                <div style="font-size:64px">💭</div>
                <h3>لم تطرح أي سؤال بعد</h3>
                <p class="fs-text-muted">اسأل مدرسي المنصة عن أي شيء يصعب عليك في الدراسة</p>
                <a href="/student/tickets/new" class="fs-btn fs-btn-primary">اطرح أول سؤال</a>
            </div>
        }
        else
        {
            <div class="tickets-list">
                @foreach (var t in _tickets)
                {
                    <a href="/student/tickets/@t.Id" class="ticket-row fs-card">
                        <span class="status-icon @GetStatusClass(t.Status)">@StatusIcon(t.Status)</span>
                        <div class="ticket-info">
                            <strong>@t.Title</strong>
                            <small>
                                @t.SubjectName · @StatusLabel(t.Status)
                                @if (t.HasReply) { <span class="reply-badge">✓ تم الرد</span> }
                            </small>
                        </div>
                        <div class="ticket-meta">
                            <small>@t.MessagesCount رسالة</small>
                            <small>@t.CreatedAtUtc.ToString("yyyy/MM/dd")</small>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

<style>
    .tickets-page { padding: var(--fs-s-10) 0; min-height: calc(100vh - 72px); }
    .page-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--fs-s-6); flex-wrap: wrap; gap: var(--fs-s-3); }
    .page-head h1 { font-size: 28px; }
    .empty { padding: 80px; text-align: center; }
    .empty h3 { margin: var(--fs-s-3) 0 var(--fs-s-2); }
    .empty .fs-btn { margin-top: var(--fs-s-4); }

    .tickets-list { display: flex; flex-direction: column; gap: var(--fs-s-3); }
    .ticket-row {
        display: flex; align-items: center; gap: var(--fs-s-4);
        padding: var(--fs-s-4); color: inherit; text-decoration: none;
        transition: all var(--fs-trans);
    }
    .ticket-row:hover { transform: translateX(-4px); border-color: var(--fs-primary); }

    .status-icon {
        width: 44px; height: 44px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 22px; flex-shrink: 0;
    }
    .status-open { background: var(--fs-primary-soft); color: var(--fs-primary); }
    .status-answered { background: #D1FAE5; color: var(--fs-success); }
    .status-resolved { background: var(--fs-secondary-soft); color: var(--fs-secondary); }
    .status-closed { background: var(--fs-border); color: var(--fs-text-muted); }

    .ticket-info { flex: 1; }
    .ticket-info strong { display: block; font-size: 15px; line-height: 1.4; margin-bottom: 4px; }
    .ticket-info small { font-size: 12px; color: var(--fs-text-muted); }
    .reply-badge { color: var(--fs-success); font-weight: 700; margin-right: var(--fs-s-2); }

    .ticket-meta { text-align: left; }
    .ticket-meta small { display: block; font-size: 12px; color: var(--fs-text-muted); }
</style>

@code {
    private List<FSEdu.Shared.Contracts.Tickets.TicketListItemDto>? _tickets;
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.RestoreAsync();
            if (Auth.IsAuthenticated)
            {
                try { _tickets = await Api.GetMyTicketsAsync(); } catch { }
            }
            _loaded = true; StateHasChanged();
        }
    }

    private static string StatusLabel(string s) => s switch
    {
        "Open" => "مفتوح", "Answered" => "تم الرد",
        "Resolved" => "محلول", "Closed" => "مغلق", _ => s
    };

    private static string StatusIcon(string s) => s switch
    {
        "Open" => "❓", "Answered" => "💬",
        "Resolved" => "✅", "Closed" => "🔒", _ => "📩"
    };

    private static string GetStatusClass(string s) => s switch
    {
        "Open" => "status-open", "Answered" => "status-answered",
        "Resolved" => "status-resolved", _ => "status-closed"
    };
}
