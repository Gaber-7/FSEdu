    private static bool IsYouTube(string url) =>
        url.Contains("youtube.com") || url.Contains("youtu.be");

    private static string GetYouTubeEmbed(string url)
    {
        if (url.Contains("watch?v="))
        {
            var id = url.Split("watch?v=")[1].Split('&')[0];
            return $"https://www.youtube.com/embed/{id}";
        }
        if (url.Contains("youtu.be/"))
        {
            var id = url.Split("youtu.be/")[1].Split('?')[0];
            return $"https://www.youtube.com/embed/{id}";
        }
        return url;
    }

    private static string TypeLabel(string t) => t switch
    {
        "Recorded" => "درس مسجّل", "Live" => "حصة مباشرة",
        "Document" => "مذكرة", "Quiz" => "اختبار", _ => t
    };

    private static string FormatDuration(int sec)
    {
        var m = sec / 60;
        return m > 60 ? $"{m / 60}س {m % 60}د" : $"{m} دقيقة";
    }
