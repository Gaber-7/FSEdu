        });

        _hub.On("WhiteboardCleared", async () =>
        {
            try { await JS.InvokeVoidAsync("fseduWhiteboard.clearAll", false); } catch { }
        });

        _hub.On<object>("WhiteboardSnapshot", async strokes =>
        {
            if (_session?.IsTeacher == true) return;
            await EnsureWhiteboardAttachedAsync();
            try { await JS.InvokeVoidAsync("fseduWhiteboard.applySnapshot", strokes); } catch { }
        });

        try
        {
            await _hub.StartAsync();
            await _hub.SendAsync("JoinRoom", SessionId.ToString());
            _connected = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = "فشل الاتصال بغرفة البث: " + ex.Message;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageDraft) || _hub is null) return;
        var text = _messageDraft.Trim();
        _messageDraft = "";
        try { await _hub.SendAsync("SendMessage", SessionId.ToString(), text); }
        catch { }
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_messageDraft))
            await SendMessage();
    }

    private void ToggleSidePane() => _sidePaneOpen = !_sidePaneOpen;

    private async Task ToggleHand()
    {
        if (_hub is null) return;
        _handRaised = !_handRaised;
        try { await _hub.SendAsync("RaiseHand", SessionId.ToString(), _handRaised); }
        catch { }
    }

    private void TogglePollComposer()
    {
        _pollComposerOpen = !_pollComposerOpen;
        if (_pollComposerOpen)
        {
            _newPollQuestion = "";
            _newPollOptions = new() { "", "" };
        }
    }

    private void AddPollOption()
    {
        if (_newPollOptions.Count < 6) _newPollOptions.Add("");
    }

    private void RemovePollOption(int idx)
    {
        if (idx >= 0 && idx < _newPollOptions.Count) _newPollOptions.RemoveAt(idx);
    }

    private async Task SubmitPoll()
    {
        if (_hub is null) return;
        var opts = _newPollOptions.Where(o => !string.IsNullOrWhiteSpace(o))
                                  .Select(o => o.Trim()).ToArray();
        if (string.IsNullOrWhiteSpace(_newPollQuestion) || opts.Length < 2) return;
        try
        {
            await _hub.SendAsync("CreatePoll", SessionId.ToString(), _newPollQuestion.Trim(), opts);
            _pollComposerOpen = false;
        }
        catch { }
    }

    private async Task Vote(int idx)
    {
        if (_hub is null || _activePoll is null) return;
        try
        {
            await _hub.SendAsync("VoteOnPoll", SessionId.ToString(), _activePoll.PollId, idx);
            // optimistic local update of MyVote — counts will be updated by broadcast
            _activePoll = _activePoll with { MyVote = idx };
        }
        catch { }
    }

    private async Task ClosePoll()
    {
        if (_hub is null || _activePoll is null) return;
        try { await _hub.SendAsync("ClosePoll", SessionId.ToString()); }
        catch { }
    }

    private async Task CallOnStudent(Guid studentUserId)
    {
        if (_hub is null) return;
        try { await _hub.SendAsync("CallOnStudent", SessionId.ToString(), studentUserId.ToString()); }
        catch { }
    }

    private async Task ShowCalledBanner(string name)
    {
        _calledBannerCts?.Cancel();
        _calledBannerCts = new CancellationTokenSource();
        var token = _calledBannerCts.Token;
        _calledOnName = name;
        await InvokeAsync(StateHasChanged);
        try { await Task.Delay(5000, token); } catch { return; }
        if (!token.IsCancellationRequested)
        {
            _calledOnName = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatAgo(DateTime? utc)
    {
        if (utc is null) return "";
        var diff = DateTime.UtcNow - utc.Value;
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds} ثانية";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} دقيقة";
        return $"{(int)diff.TotalHours} ساعة";
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_wbAttached) await JS.InvokeVoidAsync("fseduWhiteboard.detach"); } catch { }
        _wbDotNetRef?.Dispose();
        try { await JS.InvokeVoidAsync("fseduLiveKit.disconnect"); } catch { }
        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); } catch { }
        }
    }
}
