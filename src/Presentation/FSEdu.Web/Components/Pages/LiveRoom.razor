    private HubConnection? _hub;
    private bool _connected;

    private bool _lkConnecting;
    private bool _lkConnected;
    private string? _lkError;
    private bool _micOn = true, _camOn = true, _screenOn;
    private bool _recording, _recordingBusy;
    private string? _recordingError;

    private bool _endingSession;
    private bool _whiteboardActive;
    private bool _wbAttached;
    private DotNetObjectReference<LiveRoom>? _wbDotNetRef;
    private record PenState(string Color, int Width, string Mode);
    private PenState _pen = new("#111111", 4, "pen");
    private static readonly string[] _palette =
        new[] { "#111111", "#DC2626", "#2563EB", "#16A34A", "#F59E0B", "#A855F7" };

    private readonly Dictionary<Guid, ParticipantState> _participants = new();
    private readonly List<ChatMessage> _messages = new();
    private string _messageDraft = "";
    private bool _handRaised;
    private string _activeTab = "chat";
    private ElementReference _messagesEl;

    private record ParticipantState(Guid UserId, string UserName, bool IsTeacher, bool HandRaised, DateTime? HandRaisedAtUtc = null);

    private string? _calledOnName;
    private CancellationTokenSource? _calledBannerCts;

    private bool _sidePaneOpen;

    private record PollState(string PollId, string Question, string[] Options, int[] Counts, int? MyVote, bool Closed);
    private PollState? _activePoll;
    private bool _pollComposerOpen;
    private string _newPollQuestion = "";
    private List<string> _newPollOptions = new() { "", "" };
    private record ChatMessage(Guid SenderId, string SenderName, bool IsTeacher, string Body, DateTime SentAt);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.RestoreAsync();
            if (!Auth.IsAuthenticated)
            {
                _error = "يجب تسجيل الدخول أولاً";
                _loaded = true; StateHasChanged();
                return;
            }

            var (data, err) = await Api.JoinLiveSessionAsync(SessionId);
            if (err is not null) { _error = err.Message; _loaded = true; StateHasChanged(); return; }
            _session = data;
            _loaded = true; StateHasChanged();

            await ConnectHub();
            await ConnectLiveKitIfReady();
        }
    }

    private async Task ConnectLiveKitIfReady()
    {
        if (_session is null) return;
        if (_session.Status != "Live") return;
        if (string.IsNullOrEmpty(_session.LiveKitUrl) || string.IsNullOrEmpty(_session.LiveKitToken)) return;
        if (_lkConnected || _lkConnecting) return;

        _lkConnecting = true; _lkError = null; StateHasChanged();
        try
        {
            var apiBase = Config["ApiBaseUrl"] ?? "http://localhost:5080/";
            await JS.InvokeAsync<object>("fseduLiveKit.connect", new
            {
                url = _session.LiveKitUrl,
                token = _session.LiveKitToken,
                containerId = "lk-video-grid",
                publish = _session.IsTeacher,
                sessionId = SessionId.ToString(),
                appAuthToken = Api.GetCurrentToken(),
                apiBase = apiBase
            });
            _lkConnected = true;
        }
        catch (Exception ex)
        {
            _lkError = "تعذّر الاتصال بالبث المباشر: " + ex.Message;
        }
        finally
        {
            _lkConnecting = false;
            StateHasChanged();
        }
    }

    private async Task ToggleMic()
    {
        _micOn = !_micOn;
        try { await JS.InvokeVoidAsync("fseduLiveKit.setMic", _micOn); } catch { }
    }
    private async Task ToggleCam()
    {
        _camOn = !_camOn;
        try { await JS.InvokeVoidAsync("fseduLiveKit.setCam", _camOn); } catch { }
    }
    private async Task ToggleScreen()
    {
        _screenOn = !_screenOn;
        try { await JS.InvokeVoidAsync("fseduLiveKit.setScreen", _screenOn); } catch { }
    }

    private async Task EndBroadcast()
    {
        if (_endingSession) return;
        if (!await JS.InvokeAsync<bool>("confirm", "هل أنت متأكد من إنهاء البث؟ سيتم إغلاق الحصة لجميع الحاضرين."))
            return;
        _endingSession = true; StateHasChanged();
        try
        {
            // Stop recording first if active so the file gets uploaded
            if (_recording)
            {
                try { await JS.InvokeAsync<object>("fseduLiveKit.stopRecording"); } catch { }
                _recording = false;
            }
            var err = await Api.EndLiveSessionAsync(SessionId);
            if (err is not null)
            {
                _recordingError = "تعذّر إنهاء البث: " + err.Message;
            }
            else
            {
                Nav.NavigateTo("/teacher/live");
            }
        }
        finally { _endingSession = false; StateHasChanged(); }
    }

    private async Task ToggleWhiteboard()
    {
        _whiteboardActive = !_whiteboardActive;
        StateHasChanged();
        if (_whiteboardActive)
        {
            // Wait one render cycle so the canvas exists in DOM
            await Task.Yield();
            if (!_wbAttached)
            {
                _wbDotNetRef ??= DotNetObjectReference.Create(this);
                try
                {
                    await JS.InvokeVoidAsync("fseduWhiteboard.attach", new
                    {
                        canvasId = "fsedu-whiteboard",
                        isTeacher = _session?.IsTeacher ?? false,
                        dotnetRef = _wbDotNetRef
                    });
                    _wbAttached = true;
                    await JS.InvokeVoidAsync("fseduWhiteboard.setTool", new
                    {
                        color = _pen.Color, width = _pen.Width, mode = _pen.Mode
                    });
                }
                catch (Exception ex) { Console.Error.WriteLine("[wb attach] " + ex.Message); }
            }
            // Tell the recorder composer to capture this canvas as primary surface
            try { await JS.InvokeVoidAsync("fseduLiveKit.setWhiteboardCanvas", "fsedu-whiteboard"); } catch { }
        }
        else
        {
            try { await JS.InvokeVoidAsync("fseduLiveKit.setWhiteboardCanvas", (string?)null); } catch { }
            if (_wbAttached)
            {
                try { await JS.InvokeVoidAsync("fseduWhiteboard.detach"); } catch { }
                _wbAttached = false;
            }
        }
    }

    private async Task SetPenMode(string mode)
    {
        _pen = _pen with { Mode = mode };
        try { await JS.InvokeVoidAsync("fseduWhiteboard.setTool", new { mode }); } catch { }
    }

    private async Task SetPenColor(string color)
    {
        _pen = _pen with { Color = color, Mode = "pen" };
        try { await JS.InvokeVoidAsync("fseduWhiteboard.setTool", new { color, mode = "pen" }); } catch { }
    }

    private async Task OnPenWidthChanged(ChangeEventArgs e)
    {
        if (e.Value is null) return;
        if (int.TryParse(e.Value.ToString(), out var w))
        {
            _pen = _pen with { Width = w };
            try { await JS.InvokeVoidAsync("fseduWhiteboard.setTool", new { width = w }); } catch { }
        }
    }

    private async Task ClearWhiteboard()
    {
        try { await JS.InvokeVoidAsync("fseduWhiteboard.clearAll", true); } catch { }
        if (_hub is not null)
        {
            try { await _hub.SendAsync("ClearWhiteboard", SessionId.ToString()); } catch { }
        }
    }

    [JSInvokable]
    public async Task OnStrokeFinished(object stroke)
    {
        if (_hub is null) return;
        try { await _hub.SendAsync("DrawStroke", SessionId.ToString(), stroke); } catch { }
    }

    // Auto-show + attach whiteboard for students when the teacher starts drawing.
    private async Task EnsureWhiteboardAttachedAsync()
    {
        if (!_whiteboardActive)
        {
            _whiteboardActive = true;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
        }
        if (!_wbAttached)
        {
            _wbDotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("fseduWhiteboard.attach", new
                {
                    canvasId = "fsedu-whiteboard",
                    isTeacher = false,
                    dotnetRef = _wbDotNetRef
                });
                _wbAttached = true;
            }
            catch { }
        }
    }

    private async Task ToggleRecording()
    {
        if (_recordingBusy || _session is null) return;
        _recordingBusy = true; _recordingError = null; StateHasChanged();
        try
        {
            if (_recording)
            {
                // Stop + upload (may take time for large files — show busy state)
                await JS.InvokeAsync<object>("fseduLiveKit.stopRecording");
                _recording = false;
            }
            else
            {
                await JS.InvokeAsync<object>("fseduLiveKit.startRecording");
                _recording = true;
            }
        }
        catch (Exception ex)
        {
            _recordingError = ex.Message;
        }
        finally
        {
            _recordingBusy = false;
            StateHasChanged();
        }
    }

    private async Task ConnectHub()
    {
        if (_session is null) return;
        var apiBase = Config["ApiBaseUrl"] ?? "http://localhost:5080/";
        var token = Api.GetCurrentToken();
        if (string.IsNullOrEmpty(token)) { _error = "رمز المصادقة غير متوفر"; StateHasChanged(); return; }

        var hubUrl = apiBase.TrimEnd('/') + "/hubs/classroom";
        _hub = new HubConnectionBuilder()
            .WithUrl(hubUrl, opts => opts.AccessTokenProvider = () => Task.FromResult<string?>(token))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<dynamic>("UserJoined", info =>
        {
            try
            {
                var json = System.Text.Json.JsonSerializer.Serialize(info);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                var uid = Guid.Parse(root.GetProperty("userId").GetString()!);
                var name = root.GetProperty("userName").GetString()!;
                var isT = root.GetProperty("isTeacher").GetBoolean();
                _participants[uid] = new ParticipantState(uid, name, isT, false);
                InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        _hub.On<dynamic>("UserLeft", info =>
        {
            try
            {
                var json = System.Text.Json.JsonSerializer.Serialize(info);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var uid = Guid.Parse(doc.RootElement.GetProperty("userId").GetString()!);
                _participants.Remove(uid);
                InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        _hub.On<dynamic>("Roster", roster =>
        {
            try
            {
                var json = System.Text.Json.JsonSerializer.Serialize(roster);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                foreach (var p in doc.RootElement.EnumerateArray())
                {
                    var uid = Guid.Parse(p.GetProperty("userId").GetString()!);
                    var name = p.GetProperty("userName").GetString()!;
                    var isT = p.GetProperty("isTeacher").GetBoolean();
                    var hand = p.GetProperty("handRaised").GetBoolean();
                    DateTime? handAt = null;
                    if (p.TryGetProperty("handRaisedAtUtc", out System.Text.Json.JsonElement hp) && hp.ValueKind == System.Text.Json.JsonValueKind.String)
                        handAt = hp.GetDateTime();
                    _participants[uid] = new ParticipantState(uid, name, isT, hand, handAt);
                }
                InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        _hub.On<dynamic>("MessageReceived", msg =>
        {
            try
            {
                var json = System.Text.Json.JsonSerializer.Serialize(msg);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                _messages.Add(new ChatMessage(
                    Guid.Parse(root.GetProperty("senderId").GetString()!),
                    root.GetProperty("senderName").GetString()!,
                    root.GetProperty("isTeacher").GetBoolean(),
                    root.GetProperty("body").GetString()!,
                    root.GetProperty("sentAtUtc").GetDateTime()));
                InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        _hub.On<dynamic>("HandRaised", info =>
        {
            try
            {
                var json = System.Text.Json.JsonSerializer.Serialize(info);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                var uid = Guid.Parse(root.GetProperty("userId").GetString()!);
                var raised = root.GetProperty("raised").GetBoolean();
                DateTime? handAt = null;
                if (root.TryGetProperty("handRaisedAtUtc", out System.Text.Json.JsonElement hp) && hp.ValueKind == System.Text.Json.JsonValueKind.String)
                    handAt = hp.GetDateTime();
                if (_participants.TryGetValue(uid, out ParticipantState? p))
                    _participants[uid] = p! with { HandRaised = raised, HandRaisedAtUtc = handAt };
                InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        _hub.On<dynamic>("PollStarted", info =>
        {
            try
            {
                var json = System.Text.Json.JsonSerializer.Serialize((object)info);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                var pollId = root.GetProperty("pollId").GetString()!;
                var q = root.GetProperty("question").GetString()!;
                var optsList = new List<string>();
                foreach (var x in root.GetProperty("options").EnumerateArray())
                    optsList.Add(x.GetString() ?? "");
                var countsList = new List<int>();
                foreach (var x in root.GetProperty("counts").EnumerateArray())
                    countsList.Add(x.GetInt32());
                int? myVote = null;
                if (root.TryGetProperty("myVote", out System.Text.Json.JsonElement mv)
                    && mv.ValueKind == System.Text.Json.JsonValueKind.Number)
                    myVote = mv.GetInt32();
                _activePoll = new PollState(pollId, q, optsList.ToArray(), countsList.ToArray(), myVote, false);
                _pollComposerOpen = false;
                InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        _hub.On<dynamic>("PollVoteUpdate", info =>
        {
            try
            {
                if (_activePoll is null) return;
                var json = System.Text.Json.JsonSerializer.Serialize((object)info);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                var pollId = root.GetProperty("pollId").GetString()!;
                if (pollId != _activePoll.PollId) return;
                var countsList = new List<int>();
                foreach (var x in root.GetProperty("counts").EnumerateArray())
                    countsList.Add(x.GetInt32());
                _activePoll = _activePoll with { Counts = countsList.ToArray() };
                InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        _hub.On<dynamic>("PollClosed", info =>
        {
            try
            {
                if (_activePoll is null) return;
                var json = System.Text.Json.JsonSerializer.Serialize((object)info);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                var pollId = root.GetProperty("pollId").GetString()!;
                if (pollId != _activePoll.PollId) return;
                var countsList = new List<int>();
                foreach (var x in root.GetProperty("counts").EnumerateArray())
                    countsList.Add(x.GetInt32());
                _activePoll = _activePoll with { Counts = countsList.ToArray(), Closed = true };
                InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        _hub.On<dynamic>("StudentCalledOn", info =>
        {
            try
            {
                var json = System.Text.Json.JsonSerializer.Serialize(info);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                var name = root.GetProperty("userName").GetString() ?? "طالب";
                _ = ShowCalledBanner(name);
            }
            catch { }
        });

        _hub.On<object>("StrokeReceived", async stroke =>
        {
