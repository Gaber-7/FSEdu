    .lk-btn.on { background: var(--fs-primary); border-color: var(--fs-primary); }
    .lk-btn.rec { background: #DC2626; border-color: #DC2626; animation: pulse 1.5s infinite; }
    .lk-btn.end { background: #B91C1C; border-color: #B91C1C; }
