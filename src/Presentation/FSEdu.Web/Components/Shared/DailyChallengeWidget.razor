@using FSEdu.Shared.Contracts.Gamification
@inject FSEdu.Web.Services.ApiClient Api
@rendermode InteractiveServer

@if (_dto is not null)
{
    var pct = _dto.TargetValue == 0 ? 0 : (int)Math.Min(100, _dto.ProgressValue * 100 / _dto.TargetValue);
    <div class="dc-card @(_dto.Completed ? "done" : "")">
        <div class="dc-head">
            <span class="dc-icon">@_dto.IconEmoji</span>
            <div class="dc-title-block">
                <strong class="dc-title">@_dto.Title</strong>
                <small class="dc-desc">@_dto.Description</small>
            </div>
            <div class="dc-xp">+@_dto.XpReward XP</div>
        </div>

        <div class="dc-progress">
            <div class="dc-bar"><div class="dc-fill" style="width: @(pct)%"></div></div>
            <small>@_dto.ProgressValue / @_dto.TargetValue</small>
        </div>

        <div class="dc-foot">
            <span class="dc-streak" title="السلسلة الحالية">
                🔥 <strong>@_dto.CurrentStreakDays</strong> يوم
            </span>
            <span class="dc-shields" title="دروع تحمى سلسلتك من الانقطاع">
                @for (int i = 0; i < Math.Min(_dto.StreakShields, 5); i++) { <span>🛡️</span> }
                @if (_dto.StreakShields > 5) { <small>+@(_dto.StreakShields - 5)</small> }
                @if (_dto.StreakShields == 0) { <small class="muted">لا دروع</small> }
            </span>
            @if (_dto.Completed)
            {
                <span class="dc-done">✓ مكتمل</span>
            }
        </div>
    </div>
}

<style>
    .dc-card {
        background: linear-gradient(135deg, var(--fs-primary-soft), white);
        border: 1px solid var(--fs-primary);
        border-radius: var(--fs-r-xl); padding: var(--fs-s-4);
        display: flex; flex-direction: column; gap: var(--fs-s-3);
    }
    .dc-card.done {
        background: linear-gradient(135deg, #DCFCE7, white);
        border-color: #16A34A;
    }
    .dc-head { display: flex; gap: var(--fs-s-3); align-items: center; }
    .dc-icon { font-size: 36px; }
    .dc-title-block { flex: 1; }
    .dc-title { display: block; font-size: 15px; font-weight: 700; }
    .dc-desc { color: var(--fs-text-muted); font-size: 12px; }
    .dc-xp {
        background: var(--fs-primary); color: white;
        padding: 4px 12px; border-radius: var(--fs-r-full);
        font-weight: 800; font-size: 13px;
    }

    .dc-progress { display: flex; align-items: center; gap: var(--fs-s-3); }
    .dc-bar { flex: 1; height: 8px; background: rgba(255,255,255,0.6); border-radius: var(--fs-r-full); overflow: hidden; }
    .dc-fill {
        height: 100%; background: linear-gradient(90deg, var(--fs-primary), var(--fs-secondary));
        border-radius: var(--fs-r-full);
        transition: width 0.4s ease;
    }
    .dc-progress small { font-size: 12px; font-weight: 700; color: var(--fs-text-muted); white-space: nowrap; }

    .dc-foot { display: flex; gap: var(--fs-s-4); align-items: center; flex-wrap: wrap; font-size: 13px; }
    .dc-streak strong { color: #DC2626; font-size: 16px; }
    .dc-shields { display: flex; align-items: center; gap: 2px; }
    .dc-shields .muted { color: var(--fs-text-muted); font-size: 11px; }
    .dc-done { color: #15803D; font-weight: 700; }
</style>

@code {
    private DailyChallengeStatusDto? _dto;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _dto = await Api.GetDailyChallengeAsync();
        StateHasChanged();
    }
}
